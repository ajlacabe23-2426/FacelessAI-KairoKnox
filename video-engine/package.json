{
  "name": "kairo-coded-animation",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:pilot": "remotion render src/index.ts MicroLearningPilot out/micro-learning-pilot.mp4 --codec=h264 --concurrency=1",
    "render:smoke": "remotion render src/index.ts MicroLearningPilot out/smoke.mp4 --codec=h264 --concurrency=1 --scale=0.5 --frames=0-59",
    "typecheck": "tsc --noEmit",
    "render:signal": "remotion render src/index.ts SignalCutPilot out/signal-cut-pilot.mp4 --codec=h264 --concurrency=1",
    "render:signal:smoke": "remotion render src/index.ts SignalCutPilot out/signal-smoke.mp4 --codec=h264 --concurrency=1 --scale=0.5 --frames=0-59",
    "motion:check": "node scripts/check-cinema.mjs",
    "render:cinema:smoke": "remotion render src/index.ts KairoCinematic60 out/cinema-smoke.mp4 --codec=h264 --concurrency=1 --scale=0.5 --frames=0-119",
    "render:cinema": "remotion render src/index.ts KairoCinematic60 out/cinema-1080x1920-60fps.mp4 --codec=h264 --concurrency=1",
    "render:cinema:4k": "remotion render src/index.ts KairoCinematic60 out/cinema-2160x3840-60fps.mp4 --codec=h264 --concurrency=1 --scale=2",
    "fluid:check": "node scripts/check-fluid.mjs",
    "render:NvidiaEconomyFluid60": "remotion render src/index.ts NvidiaEconomyFluid60 out/NvidiaEconomyFluid60.mp4 --codec=h264 --concurrency=2",
    "render:AgentProgrammingFluid60": "remotion render src/index.ts AgentProgrammingFluid60 out/AgentProgrammingFluid60.mp4 --codec=h264 --concurrency=2",
    "render:PromptEngineeringFluid60": "remotion render src/index.ts PromptEngineeringFluid60 out/PromptEngineeringFluid60.mp4 --codec=h264 --concurrency=2",
    "render:CarBuyingFluid60": "remotion render src/index.ts CarBuyingFluid60 out/CarBuyingFluid60.mp4 --codec=h264 --concurrency=2"
  },
  "dependencies": {
    "@remotion/gsap": "4.0.539",
    "gsap": "3.14.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.539",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
